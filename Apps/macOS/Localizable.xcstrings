      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Claude Code and Codex session on this Mac, in panes or not. Cost is at API list prices, not what a plan bills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las sesiones de Claude Code y Codex del Mac, dentro o fuera de paneles. El coste se estima con precios de API, no con la factura del plan."
          }
        },
        "pt-BR": {
