    "Leave the secret blank to keep it. The first server key is remembered; a changed key blocks the connection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the secret blank to keep it. The first server key is remembered; a changed key blocks the connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el secreto vacío para conservarlo. Se recuerda la primera clave del servidor; si cambia, se bloquea la conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o segredo em branco para mantê-lo. A primeira chave do servidor é memorizada; uma chave diferente bloqueia a conexão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将密码或私钥留空可保留原值。首次服务器密钥会被保存；密钥更改后将阻止连接。"
          }
        }
      }
    },
