    "Starts from the current commit; uncommitted changes stay in the original folder. Existing panes stay where they are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts from the current commit; uncommitted changes stay in the original folder. Existing panes stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza en el commit actual; los cambios sin commit quedan en la carpeta original. Los paneles existentes no cambian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa no commit atual; alterações não commitadas ficam na pasta original. Painéis existentes não mudam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
