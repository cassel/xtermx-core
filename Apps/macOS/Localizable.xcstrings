        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将推出"
          }
        }
      }
    },
    "One conversation to message several agents at once and read what they send each other. It lives in the right panel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One conversation to message several agents at once and read what they send each other. It lives in the right panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación para hablar con varios agentes y leer lo que se envían entre sí, en el panel derecho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa para falar com vários agentes e ler o que trocam entre si, no painel direito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧面板中，同时向多个智能体发送消息，并查看它们之间的交流。"
          }
        }
      }
    },
    "Only XTermX's activity file is removed. It records new events again while logging is on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only XTermX's activity file is removed. It records new events again while logging is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina el archivo de actividad de XTermX. Se registrarán eventos nuevos si el registro sigue activo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o arquivo de atividade do XTermX é removido. Novos eventos voltam a ser registrados se o log estiver ligado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除 XTermX 活动文件。日志开启时仍会记录新事件。"
          }
        }
      }
    },
    "Only do this after verifying a server's key change through another trusted channel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only do this after verifying a server's key change through another trusted channel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazlo solo tras verificar el cambio de clave por otro canal de confianza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só faça isso após confirmar a mudança da chave por outro canal confiável."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在通过其他可信渠道确认服务器密钥更改后执行此操作。"
          }
        }
      }
    },
    "Only real sends and reports draw a trail. Reduce Motion uses a brief static line.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only real sends and reports draw a trail. Reduce Motion uses a brief static line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los envíos e informes reales dibujan rastros. Con Reducir movimiento, la línea es breve y estática."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só envios e relatórios reais geram trilhas. Com Reduzir Movimento, a linha é estática e breve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅真实消息和报告会显示轨迹。启用“减弱动态效果”时使用短暂静态线条。"
          }
        }
      }
    },
    "Only time, action, pane kind, an opaque reference and whether an agent opened it. No terminal text, prompts, folders, host names or secrets. Up to 2,000 events.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only time, action, pane kind, an opaque reference and whether an agent opened it. No terminal text, prompts, folders, host names or secrets. Up to 2,000 events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hora, acción, tipo de panel, referencia opaca y si lo abrió un agente. Sin texto, prompts, carpetas, hosts ni secretos. Hasta 2.000 eventos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas horário, ação, tipo de painel, referência opaca e se foi aberto por um agente. Sem texto do terminal, prompts, pastas, hosts ou segredos. Até 2.000 eventos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录时间、操作、面板类型、不透明引用及是否由智能体请求创建。不记录终端文本、提示词、文件夹、主机名或密钥。最多 2,000 条事件。"
          }
        }
      }
    },
