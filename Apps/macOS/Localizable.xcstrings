    "XTermX adds a few hooks to their settings, so each session reports its status, tokens and plan limits, and you can answer it from any device. Turning this off takes them out again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XTermX adds a few hooks to their settings, so each session reports its status, tokens and plan limits, and you can answer it from any device. Turning this off takes them out again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "XTermX añade hooks a los ajustes para informar estado, tokens y límites y permitir respuestas desde otros dispositivos. Desactivarlo elimina esos hooks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O XTermX adiciona hooks às configurações para informar estado, tokens e limites e permitir respostas por outros aparelhos. Desativar remove esses hooks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "XTermX 会在智能体配置中添加钩子，以报告状态、令牌用量和套餐限额，并允许从其他设备答复。关闭此选项会移除这些钩子。"
          }
        }
      }
    },
    "XTermX does not install an update from this page. Check release signing and requirements before replacing your copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "XTermX does not install an update from this page. Check release signing and requirements before replacing your copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no instala actualizaciones. Comprueba la firma y los requisitos antes de sustituir tu copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página não instala atualizações. Confira a assinatura e os requisitos antes de substituir sua cópia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面不会安装更新。替换应用前请检查版本签名和系统要求。"
          }
        }
      }
    },
