    "⌘D splits right, ⌘⇧D down; ⌃⇧ and an arrow moves a pane, ⌘P evens them out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D splits right, ⌘⇧D down; ⌃⇧ and an arrow moves a pane, ⌘P evens them out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D divide a la derecha, ⌘⇧D abajo; ⌃⇧ y una flecha mueve el panel, ⌘P equilibra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D divide à direita, ⌘⇧D abaixo; ⌃⇧ e uma seta move o painel, ⌘P equilibra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D 向右分屏，⌘⇧D 向下分屏；⌃⇧ 加方向键移动面板，⌘P 均分面板。"
