    "Each request shows a card here, on your iPhone and on your Watch. No answer in 120 s means no.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each request shows a card here, on your iPhone and on your Watch. No answer in 120 s means no."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada solicitud aparece aquí, en iPhone y Watch. Sin respuesta en 120 s, se rechaza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pedido aparece aqui, no iPhone e no Watch. Sem resposta em 120 s, é negado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个请求会在此处、iPhone 和 Watch 上显示。120 秒内未答复即拒绝。"
