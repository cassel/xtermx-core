    "Keep is always safe. Removing the clean folder keeps its branch and commits. Merging needs both folders clean and the original branch checked out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep is always safe. Removing the clean folder keeps its branch and commits. Merging needs both folders clean and the original branch checked out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar no cambia nada. Eliminar la carpeta limpia conserva la rama y los commits. Para fusionar, ambas carpetas deben estar limpias y la rama original activa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter preserva tudo. Remover a pasta limpa mantém a branch e os commits. Para mesclar, ambas as pastas devem estar limpas e a branch original ativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留不会改动工作树。移除无改动的文件夹会保留分支及提交。合并要求两个工作目录均无改动，且原仓库已切回原分支。"
          }
        }
      }
    },
