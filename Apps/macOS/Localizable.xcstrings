    "Open adds new tabs. Agents start fresh; unavailable agents open as shells. Missing folders use your home folder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open adds new tabs. Agents start fresh; unavailable agents open as shells. Missing folders use your home folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir añade pestañas nuevas. Los agentes empiezan de cero; si no están disponibles se abren shells. Las carpetas ausentes usan tu carpeta personal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir adiciona novas abas. Agentes iniciam do zero; indisponíveis viram shells. Pastas ausentes usam sua pasta pessoal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开会添加新标签页。智能体将重新启动；不可用的智能体会改为 shell。文件夹不存在时使用个人文件夹。"
          }
