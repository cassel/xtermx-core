    "The coordinator receives messages first and may forward to the checked agents. Run still targets the checked terminals.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coordinator receives messages first and may forward to the checked agents. Run still targets the checked terminals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El coordinador recibe primero y puede reenviar a los agentes marcados. Ejecutar sigue dirigido a los terminales marcados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O coordenador recebe mensagens primeiro e pode repassar aos agentes marcados. Executar continua direcionado aos terminais marcados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协调者首先接收消息，并可转发给选中的智能体。“执行”仍直接发送到选中的终端。"
          }
        }
      }
    },
    "The copy of XTermX on this Mac; include it when you report a problem.": {
