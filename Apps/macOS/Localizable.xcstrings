            "value": "Los paneles privados se ocultan de listas y transmisiones. Solo ver no permite escribir, redimensionar ni aprobar solicitudes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Painéis privados somem das listas e transmissões. Somente ver não permite digitar, redimensionar ou aprovar pedidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密面板不会出现在设备列表或数据流中。仅查看权限不允许输入、调整尺寸或批准智能体请求。"
          }
        }
      }
    },
