    "Agents can request a pane; only a person can close it. Retention applies to XTermX's activity file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can request a pane; only a person can close it. Retention applies to XTermX's activity file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes pueden solicitar paneles; solo una persona puede cerrarlos. La retención se aplica al archivo de actividad de XTermX."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes podem pedir painéis; só uma pessoa pode fechá-los. O prazo vale para o arquivo de atividade do XTermX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可以请求创建面板，但只有人可以关闭面板。保留期限适用于 XTermX 活动文件。"
          }
        }
      }
    },
    "Agents in panes can open other agents beside them; you approve each one on the Mac, iPhone or Watch, and no answer in 120 s means no.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents in panes can open other agents beside them; you approve each one on the Mac, iPhone or Watch, and no answer in 120 s means no."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes pueden solicitar otros agentes a su lado. Apruebas en Mac, iPhone o Watch; sin respuesta en 120 s, se rechaza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes podem pedir outros agentes ao lado. Você aprova no Mac, iPhone ou Watch; sem resposta em 120 s, o pedido é negado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板中的智能体可以请求在旁边打开其他智能体。你可在 Mac、iPhone 或 Watch 上批准；120 秒内未答复即拒绝。"
          }
        }
      }
    },
