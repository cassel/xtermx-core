    "%@ will be removed from the server. Folders must be empty. This cannot be undone here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be removed from the server. Folders must be empty. This cannot be undone here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se eliminará del servidor. Las carpetas deben estar vacías. No se puede deshacer aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será removido do servidor. Pastas devem estar vazias. Não há como desfazer aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从服务器删除 %@。文件夹必须为空。此操作在这里无法撤销。"
          }
        }
      }
    },
