    "On iPhone choose Pair with a password. Use an address from Advanced and Watch port %u.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone choose Pair with a password. Use an address from Advanced and Watch port %u."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone, elige Vincular con contraseña. Usa una dirección de Avanzado y el puerto Watch %u."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone, escolha Parear com senha. Use um endereço de Avançado e a porta Watch %u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上选择“使用密码配对”。使用“高级”中的地址和 Watch 端口 %u。"
          }
        }
      }
    },
    "On the other machine run `xtermx pair` (Linux) or open Remote Access (Mac), then paste its link here — or copy a screenshot of its QR code (⌃⇧⌘4) and use Paste QR.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other machine run `xtermx pair` (Linux) or open Remote Access (Mac), then paste its link here — or copy a screenshot of its QR code (⌃⇧⌘4) and use Paste QR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el otro equipo, ejecuta `xtermx pair` (Linux) o abre Acceso remoto (Mac). Pega su enlace, o copia una captura del QR (⌃⇧⌘4) y usa Pegar imagen QR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na outra máquina, execute `xtermx pair` (Linux) ou abra Acesso remoto (Mac). Cole o link aqui, ou copie uma captura do QR (⌃⇧⌘4) e use Colar imagem QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台计算机上运行 `xtermx pair`（Linux）或打开“远程访问”（Mac）。将链接粘贴到此处，或复制二维码截图（⌃⇧⌘4）并使用“粘贴二维码图片”。"
          }
        }
      }
    },
    "On the way": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the way"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
