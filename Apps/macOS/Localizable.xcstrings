    "At least 6 characters; a generated password is harder to guess. Expiry stops new pairing attempts. Devices already paired keep access until you forget them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 6 characters; a generated password is harder to guess. Expiry stops new pairing attempts. Devices already paired keep access until you forget them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mínimo de 6 caracteres; una contraseña generada es más difícil de adivinar. Al vencer impide nuevas vinculaciones. Los dispositivos ya vinculados mantienen acceso hasta que los olvides."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mínimo de 6 caracteres; uma senha gerada é mais difícil de adivinhar. A validade impede novos pareamentos. Aparelhos já pareados mantêm acesso até serem esquecidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 6 个字符，生成的密码更难猜测。到期后将停止新的配对尝试；已配对设备仍可访问，直到你将其忘记。"
          }
        }
      }
    },
