    "A banner when an agent finishes or is waiting on you. macOS asks for permission only after you pick Yes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A banner when an agent finishes or is waiting on you. macOS asks for permission only after you pick Yes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso cuando un agente termina o espera tu respuesta. macOS solo pide permiso si eliges Sí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um aviso quando o agente termina ou precisa de você. O macOS só pede permissão se você escolher Sim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体完成任务或等待你处理时显示通知。只有选择“是”后，macOS 才会请求权限。"
          }
        }
      }
    },
