    "UTF-8 · 2 MB limit. Saving writes the existing file after checking it has not changed. Drafts stay in memory while XTermX is open. Keep a local copy before editing important files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 · 2 MB limit. Saving writes the existing file after checking it has not changed. Drafts stay in memory while XTermX is open. Keep a local copy before editing important files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 · límite de 2 MB. Guardar comprueba cambios antes de escribir en el archivo existente. Los borradores quedan en memoria mientras XTermX esté abierto. Guarda una copia local de archivos importantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 · limite de 2 MB. Salvar verifica mudanças antes de escrever no arquivo existente. Rascunhos ficam na memória enquanto o XTermX estiver aberto. Guarde uma cópia local de arquivos importantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UTF-8 · 最大 2 MB。保存前会检查原文件是否被修改，然后写入现有文件。XTermX 运行期间草稿保留在内存中。编辑重要文件前请先保存本地副本。"
          }
        }
      }
    },
